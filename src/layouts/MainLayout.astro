---
import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import '../styles/global.css';
interface Props { title?: string; description?: string }
const { title='Luminac21 × StealthGrade', description='Engineering, research, and technical documentation.' } = Astro.props;
const pageTitle = title.includes('Luminac21') ? title : `${title} — Luminac21`;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#09090b"/><meta name="description" content={description}/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`}/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet"/><title>{pageTitle}</title></head><body><div class="ambient" aria-hidden="true"></div><Header/><main id="main-content"><slot/></main><Footer/></body></html>
