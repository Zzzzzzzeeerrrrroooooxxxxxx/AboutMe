---
import MainLayout from '../../layouts/MainLayout.astro';const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<MainLayout title="Projects" description="Projects and engineering experiments by Luminac21."><section class="wrap inner-page"><span class="eyebrow">WORK / PROJECT ARCHIVE</span><h1>Selected <span>projects.</span></h1><p class="lead">A living archive of software, tools, experiments, and implementation notes. Published entries are managed through the admin workspace.</p><div class="notice" id="project-note">Connect the Supabase project to load published project entries. The archive is ready for content.</div><div class="toolbar"><input class="search-input" id="project-search" placeholder="Search projects…" aria-label="Search projects"/><span class="mono-label" id="project-count">0 ENTRIES</span></div><div class="record-grid" id="project-list"></div></section></MainLayout>
<script>
import {supabase,isSupabaseConfigured} from '../../lib/supabase';
const list=document.querySelector('#project-list');const note=document.querySelector('#project-note');const count=document.querySelector('#project-count');const search=document.querySelector('#project-search');let rows=[];
function render(){const q=(search?.value||'').toLowerCase();const found=rows.filter(x=>`${x.title} ${x.summary} ${x.category}`.toLowerCase().includes(q));if(count)count.textContent=`${found.length} ENTRIES`;if(list)list.innerHTML=found.map(x=>`<article class="record-card"><div class="meta">${escapeHtml(x.category||'PROJECT')} · ${x.published_at?new Date(x.published_at).toLocaleDateString():''}</div><h3>${escapeHtml(x.title)}</h3><p>${escapeHtml(x.summary)}</p>${x.body_md?`<details><summary class=\"mono-label\">READ NOTES</summary><p class=\"markdown-body\">${escapeHtml(x.body_md)}</p></details>`:''}${x.repository_url?`<a href="${safeUrl(x.repository_url)}" target="_blank" rel="noopener">SOURCE ↗</a>`:''}${x.demo_url?` <a href="${safeUrl(x.demo_url)}" target="_blank" rel="noopener">DEMO ↗</a>`:''}</article>`).join('')||'<div class="empty-state">No published projects match this view yet.</div>';}
function escapeHtml(v=''){return String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}function safeUrl(v=''){try{const u=new URL(v);return ['https:'].includes(u.protocol)?u.href:'#'}catch{return '#'}}
search?.addEventListener('input',render);if(isSupabaseConfigured&&supabase){const {data,error}=await supabase.from('projects').select('title,summary,body_md,category,published_at,repository_url,demo_url').eq('status','published').order('published_at',{ascending:false});if(error){if(note)note.textContent='Could not load projects. Check the Supabase setup and public read policy.';}else{rows=data||[];if(note)note.classList.add('hidden');render();}}else{if(note)note.textContent='Supabase is not connected yet. Add the project URL and publishable key in your GitHub Actions secrets to enable the live archive.';render();}
</script>
