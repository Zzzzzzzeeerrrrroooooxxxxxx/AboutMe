---
import MainLayout from '../layouts/MainLayout.astro';import SectionHeading from '../components/SectionHeading.astro';import {site,focusAreas} from '../data';const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<MainLayout title="Luminac21 × StealthGrade — Engineering & Research" description="Personal engineering portfolio and technical research platform by Luminac21.">
<section class="hero wrap"><div class="hero-kicker"><span class="status-dot"></span> INDEPENDENT ENGINEERING PROFILE <span class="kicker-line"></span> ID / 21</div><p class="hero-overline">BUILDER · RESEARCH · STEALTHGRADE</p><h1>Building systems.<br/><span>Understanding</span><br/>how they work.</h1><p class="hero-copy">I'm <strong>{site.name}</strong> — documenting engineering projects, technical research, and the process behind building useful software.</p><div class="hero-actions"><a class="button button-primary" href={`${base}/projects/`}>Explore projects <span>↗</span></a><a class="button button-quiet" href={`${base}/research/`}>Read research</a></div><div class="hero-index"><span>01 — PROFILE</span><span>ENGINEERING / RESEARCH / SYSTEMS</span></div></section>
<section class="wrap intro-grid"><div><span class="eyebrow">01 / INTRODUCTION</span><h2>A personal space for<br/>technical work.</h2></div><div class="intro-copy"><p>{site.profile}</p><p>This platform brings together personal projects, research notes, development activity, and the StealthGrade collective. The goal is to publish useful work with clear context, honest limitations, and documentation that can be followed.</p><a class="text-link" href={`${base}/about/`}>More about Luminac21 <span>↗</span></a></div></section>
<section class="wrap section-block"><SectionHeading eyebrow="02 / FOCUS AREAS" title="Areas of work" description="The subjects and disciplines represented across this platform."/><div class="focus-grid">{focusAreas.map(x=><article class="focus-card"><span class="focus-number">{x.n}</span><h3>{x.title}</h3><p>{x.desc}</p></article>)}</div></section>
<section class="wrap section-block"><SectionHeading eyebrow="03 / SELECTED WORK" title="Projects & experiments" description="A structured archive for documented work, implementation notes, and release history."/><div class="project-grid"><article class="project-card"><div class="project-card-top"><span>01 / ARCHIVE</span><span class="status-pill">CONTENT-DRIVEN</span></div><div class="project-art"><span>01</span><i></i><b></b></div><h3>Project archive</h3><p>Browse software projects, their purpose, progress, and technical notes.</p><a class="card-link" href={`${base}/projects/`}>VIEW PROJECTS ↗</a></article><article class="project-card"><div class="project-card-top"><span>02 / KNOWLEDGE</span><span class="status-pill">CONTENT-DRIVEN</span></div><div class="project-art"><span>02</span><i></i><b></b></div><h3>Research notebook</h3><p>A searchable library for technical notes, references, and reproducible findings.</p><a class="card-link" href={`${base}/research/`}>READ RESEARCH ↗</a></article></div></section>
<section class="wrap collective-panel"><div><span class="eyebrow">04 / COLLECTIVE</span><h2>Luminac21 <span>×</span><br/>StealthGrade</h2></div><div><p>A collaborative identity for engineering, software research, and shared technical learning.</p><a class="button button-primary" href={`${base}/collective/`}>Explore collective <span>↗</span></a></div></section>
</MainLayout>
