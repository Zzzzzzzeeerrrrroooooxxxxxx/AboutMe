---
import MainLayout from '../../layouts/MainLayout.astro';
---
<MainLayout title="Research" description="Technical research notes and documentation."><section class="wrap inner-page"><span class="eyebrow">KNOWLEDGE / RESEARCH NOTES</span><h1>Research <span>library.</span></h1><p class="lead">Technical notes with clear scope, references, and limitations. Public articles are managed through the admin workspace.</p><div class="notice" id="research-note">Connect Supabase to load published research notes.</div><div class="toolbar"><input class="search-input" id="research-search" placeholder="Search research…" aria-label="Search research"/><span class="mono-label" id="research-count">0 ENTRIES</span></div><div class="record-grid" id="research-list"></div></section></MainLayout>
<script>
import {supabase,isSupabaseConfigured} from '../../lib/supabase';const list=document.querySelector('#research-list');const note=document.querySelector('#research-note');const count=document.querySelector('#research-count');const search=document.querySelector('#research-search');let rows=[];
const esc=(v='')=>String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function render(){const q=(search?.value||'').toLowerCase();const data=rows.filter(x=>`${x.title} ${x.excerpt} ${x.category}`.toLowerCase().includes(q));if(count)count.textContent=`${data.length} ENTRIES`;if(list)list.innerHTML=data.map(x=>`<article class="record-card"><div class="meta">${esc(x.category||'RESEARCH')} · ${x.reading_minutes||1} MIN READ</div><h3>${esc(x.title)}</h3><p>${esc(x.excerpt)}</p>${x.body_md?`<details><summary class=\"mono-label\">READ FULL NOTE</summary><p class=\"markdown-body\">${esc(x.body_md)}</p></details>`:''}</article>`).join('')||'<div class="empty-state">No published research notes match this view yet.</div>';}
search?.addEventListener('input',render);if(isSupabaseConfigured&&supabase){const {data,error}=await supabase.from('research_articles').select('title,excerpt,body_md,category,reading_minutes,published_at').eq('status','published').order('published_at',{ascending:false});if(error){if(note)note.textContent='Could not load research. Check Supabase configuration and policies.';}else{rows=data||[];note?.classList.add('hidden');render();}}else{if(note)note.textContent='Supabase is not connected. Add your project credentials through GitHub Actions secrets to enable live research entries.';render();}
</script>
