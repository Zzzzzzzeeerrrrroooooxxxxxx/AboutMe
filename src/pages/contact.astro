---
import MainLayout from '../layouts/MainLayout.astro';import {site} from '../data';
---
<MainLayout title="Contact" description="Contact Luminac21 through public channels or the contact form."><section class="wrap inner-page"><span class="eyebrow">CONNECTION / CONTACT</span><h1>Start a <span>conversation.</span></h1><p class="lead">For project discussions, collaboration, or questions, use the form or one of the public channels.</p><div class="content-panel" style="max-width:720px"><form id="contact-form"><div class="form-grid"><div class="field"><label for="sender_name">NAME</label><input id="sender_name" name="sender_name" minlength="2" maxlength="80" required autocomplete="name"/></div><div class="field"><label for="sender_email">EMAIL</label><input id="sender_email" name="sender_email" type="email" maxlength="254" required autocomplete="email"/></div><div class="field full"><label for="subject">SUBJECT</label><input id="subject" name="subject" minlength="3" maxlength="120" required/></div><div class="field full"><label for="message">MESSAGE</label><textarea id="message" name="message" minlength="10" maxlength="5000" required></textarea></div><div class="field hidden" aria-hidden="true"><label for="website">WEBSITE</label><input id="website" name="website" tabindex="-1" autocomplete="off"/></div></div><div class="form-actions"><button class="button button-primary" type="submit">SEND MESSAGE ↗</button><span class="form-status" id="contact-status" aria-live="polite"></span></div></form></div><div class="contact-list">{site.links.map(l=><a href={l.href} target="_blank" rel="noopener noreferrer"><span>{l.label} · {l.handle}</span><span>OPEN ↗</span></a>)}</div></section></MainLayout>
<script>import{isSupabaseConfigured,supabase}from'../lib/supabase';const form=document.querySelector('#contact-form');const status=document.querySelector('#contact-status');form?.addEventListener('submit',async e=>{e.preventDefault();if(!status)return;const f=new FormData(form);if(String(f.get('website')||'').trim()){status.textContent='Submission rejected.';return;}if(!isSupabaseConfigured||!supabase){status.textContent='Contact form is not connected yet. Please use one of the public channels below.';return;}const payload={sender_name:String(f.get('sender_name')||'').trim(),sender_email:String(f.get('sender_email')||'').trim(),subject:String(f.get('subject')||'').trim(),message:String(f.get('message')||'').trim()};status.textContent='Sending…';const{error}=await supabase.from('contact_messages').insert(payload);if(error){status.textContent='Could not send. Please try a public channel instead.';}else{form.reset();status.textContent='Message sent. Thank you.';}});</script>
