---
import MainLayout from '../layouts/MainLayout.astro';import {capabilityAreas} from '../data';
---
<MainLayout title="Technical Stack" description="Technologies and capabilities documented by Luminac21."><section class="wrap inner-page"><span class="eyebrow">CAPABILITIES / TOOLING</span><h1>Technical <span>stack.</span></h1><p class="lead">Tools and technical areas are described by their actual use cases rather than arbitrary skill percentages.</p><div class="capability-list">{capabilityAreas.map((x,i)=><div><span>{String(i+1).padStart(2,'0')}</span>{x}</div>)}</div><div class="content-panel"><span class="eyebrow">STACK POLICY</span><h2>Context over percentages.</h2><p>Specific technologies, versions, and project usage notes will be added through the admin workspace as they are confirmed.</p></div><div id="stack-live" class="notice">Technology entries added in the admin workspace will appear here after Supabase is connected.</div><div id="stack-items" class="capability-list"></div></section></MainLayout>
<script>import{isSupabaseConfigured,supabase}from'../lib/supabase';const el=document.querySelector('#stack-items');const note=document.querySelector('#stack-live');if(isSupabaseConfigured&&supabase){const{data,error}=await supabase.from('technologies').select('name,category,usage_note').order('sort_order');if(!error&&data?.length){if(note)note.classList.add('hidden');if(el)el.innerHTML=data.map((x,i)=>`<div><span>${String(i+1).padStart(2,'0')}</span><strong>${String(x.name).replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]))}</strong><small style="display:block;color:var(--dim);margin:4px 0 0 30px">${String(x.category).replace(/[&<>]/g,'')}</small><p style="margin:6px 0 0 30px;color:var(--muted);font-size:12px">${String(x.usage_note||'').replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]))}</p></div>`).join('');}else if(error&&note)note.textContent='Could not load technology entries. Check Supabase policies.';}</script>
