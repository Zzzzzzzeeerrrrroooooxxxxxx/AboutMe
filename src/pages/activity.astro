---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Activity" description="Development updates and release history."><section class="wrap inner-page"><span class="eyebrow">LOGS / CHANGE HISTORY</span><h1>Development <span>activity.</span></h1><p class="lead">A chronological record of releases, research publications, and project milestones.</p><div id="activity-feed" class="record-grid"><div class="empty-state">Activity feed will display public updates once Supabase is connected.</div></div></section></MainLayout>
<script>import{isSupabaseConfigured,supabase}from'../lib/supabase';const el=document.querySelector('#activity-feed');if(isSupabaseConfigured&&supabase){const{data,error}=await supabase.from('activity_logs').select('title,details,activity_type,occurred_at').eq('visibility','public').order('occurred_at',{ascending:false}).limit(30);if(!error&&el)el.innerHTML=(data||[]).map(x=>`<article class="record-card"><div class="meta">${String(x.activity_type).toUpperCase()} · ${new Date(x.occurred_at).toLocaleDateString()}</div><h3>${String(x.title).replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]))}</h3><p>${String(x.details||'').replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]))}</p></article>`).join('')||'<div class="empty-state">No public activity logged yet.</div>';}</script>
