---
import MainLayout from '../../layouts/MainLayout.astro';
---
<MainLayout title="Admin Workspace" description="Private content management workspace."><section class="wrap inner-page admin-shell"><span class="eyebrow">CONTROL / CONTENT MANAGEMENT</span><h1>Admin <span>workspace.</span></h1><p class="lead">Sign in with the single administrator account. Access is checked by Supabase Auth and database Row Level Security.</p><div id="admin-config" class="notice">If this is your first setup, add the Supabase project URL and publishable key in the deployment environment.</div><section id="login-panel" class="admin-panel"><h2>Administrator sign-in</h2><form id="login-form"><div class="field"><label for="email">EMAIL</label><input id="email" type="email" required autocomplete="username"/></div><div class="field"><label for="password">PASSWORD</label><input id="password" type="password" required autocomplete="current-password"/></div><button class="button button-primary" type="submit">SIGN IN ↗</button><p id="login-status" class="status-message" aria-live="polite"></p></form></section><section id="dashboard" class="hidden"><div class="admin-panel" style="display:flex;justify-content:space-between;align-items:center;gap:15px;flex-wrap:wrap"><div><span class="eyebrow">AUTHENTICATED SESSION</span><h2 id="admin-email" style="margin:5px 0 0">Administrator</h2></div><button id="logout" class="button button-quiet">SIGN OUT</button></div><div class="admin-tabs" role="tablist"><button class="active" data-tab="projects">PROJECTS</button><button data-tab="research">RESEARCH</button><button data-tab="activity">ACTIVITY</button><button data-tab="stack">STACK</button><button data-tab="messages">MESSAGES</button></div><div id="admin-content"></div></section></section></MainLayout>
<script>
import{isSupabaseConfigured,supabase}from'../../lib/supabase';
const $=s=>document.querySelector(s);const login=$('#login-panel');const dash=$('#dashboard');const config=$('#admin-config');const loginStatus=$('#login-status');const content=$('#admin-content');let currentTab='projects';
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const schemas={projects:{table:'projects',title:'Project',fields:[['title','Title','text',true],['slug','Slug','text',true],['category','Category','text',true],['summary','Summary','textarea',true],['body_md','Body / notes','textarea',false],['repository_url','Repository URL','url',false],['demo_url','Demo URL','url',false],['status','Status','select',true,['draft','published','archived']],['featured','Featured','checkbox',false]]},research:{table:'research_articles',title:'Research article',fields:[['title','Title','text',true],['slug','Slug','text',true],['category','Category','text',true],['excerpt','Excerpt','textarea',true],['body_md','Body / notes','textarea',false],['reading_minutes','Reading minutes','number',true],['status','Status','select',true,['draft','published','archived']]]},activity:{table:'activity_logs',title:'Activity update',fields:[['title','Title','text',true],['details','Details','textarea',false],['activity_type','Type','text',true],['visibility','Visibility','select',true,['public','private']]]},stack:{table:'technologies',title:'Technology',fields:[['name','Name','text',true],['category','Category','text',true],['usage_note','Usage note','textarea',false],['sort_order','Sort order','number',false]]}};
function fieldHtml([name,label,type,required,opts]){const req=required?'required':'';if(type==='textarea')return `<div class="field"><label>${esc(label.toUpperCase())}</label><textarea name="${name}" ${req}></textarea></div>`;if(type==='select')return `<div class="field"><label>${esc(label.toUpperCase())}</label><select name="${name}" ${req}>${opts.map(x=>`<option value="${x}">${x}</option>`).join('')}</select></div>`;if(type==='checkbox')return `<div class="field"><label><input type="checkbox" name="${name}"/> ${esc(label.toUpperCase())}</label></div>`;return `<div class="field"><label>${esc(label.toUpperCase())}</label><input name="${name}" type="${type}" ${req}/></div>`;}
async function loadTab(){if(!content||!supabase)return;const s=schemas[currentTab];if(currentTab==='messages'){content.innerHTML='<div class="admin-panel"><h2>Inbox</h2><div id="admin-list" class="admin-list">Loading…</div></div>';const{data,error}=await supabase.from('contact_messages').select('*').order('created_at',{ascending:false}).limit(100);const el=$('#admin-list');if(error){el.textContent=error.message;return;}el.innerHTML=(data||[]).map(m=>`<article class="admin-row"><div><strong>${esc(m.subject)}</strong><small>${esc(m.sender_name)} · ${esc(m.sender_email)} · ${new Date(m.created_at).toLocaleString()} · ${m.is_read?'READ':'UNREAD'}</small><p>${esc(m.message)}</p></div><button class="danger-button" data-read="${m.id}" data-value="${!m.is_read}">${m.is_read?'MARK UNREAD':'MARK READ'}</button></article>`).join('')||'<p>No messages yet.</p>';el.querySelectorAll('[data-read]').forEach(b=>b.addEventListener('click',async()=>{const{error}=await supabase.from('contact_messages').update({is_read:b.dataset.value==='true'}).eq('id',b.dataset.read);if(error)alert(error.message);else loadTab();}));return;}
content.innerHTML=`<div class="admin-panel"><h2>Create ${s.title}</h2><form id="entry-form"><input type="hidden" name="entry_id"/><div class="form-grid">${s.fields.map(fieldHtml).join('')}</div><button class="button button-primary" type="submit">SAVE ENTRY ↗</button><span id="entry-status" class="form-status"></span></form></div><div class="admin-panel"><h2>Existing entries</h2><div id="admin-list" class="admin-list">Loading…</div></div>`;
$('#entry-form')?.addEventListener('submit',async e=>{e.preventDefault();const form=e.currentTarget;const fd=new FormData(form);const row={};for(const f of s.fields){const node=form.elements.namedItem(f[0]);if(f[2]==='checkbox')row[f[0]]=node.checked;else if(f[2]==='number')row[f[0]]=Number(fd.get(f[0])||0);else row[f[0]]=String(fd.get(f[0])||'').trim();}if(['projects','research'].includes(currentTab)&&row.status==='published')row.published_at=new Date().toISOString();const entryId=String(fd.get('entry_id')||'');const result=entryId?await supabase.from(s.table).update(row).eq('id',entryId):await supabase.from(s.table).insert(row);const error=result.error;$('#entry-status').textContent=error?error.message:(entryId?'Changes updated.':'Saved.');if(!error){form.reset();form.querySelector('[name=entry_id]').value='';form.querySelector('button[type=submit]').textContent='SAVE ENTRY ↗';loadTab();}});
const{data,error}=await supabase.from(s.table).select('*').order('created_at',{ascending:false}).limit(100);const el=$('#admin-list');if(error){el.textContent=error.message;return;}el.innerHTML=(data||[]).map(x=>`<article class="admin-row"><div><strong>${esc(x.title||x.name)}</strong><small>${esc(x.status||x.category||x.activity_type||'ENTRY')} · ${new Date(x.created_at||x.occurred_at).toLocaleDateString()}</small></div><div style="display:flex;gap:7px"><button class="danger-button" data-edit="${x.id}">EDIT</button><button class="danger-button" data-delete="${x.id}">DELETE</button></div></article>`).join('')||'<p>No entries yet.</p>';el.querySelectorAll('[data-edit]').forEach(b=>b.addEventListener('click',()=>{const item=(data||[]).find(x=>x.id===b.dataset.edit);if(!item)return;const form=$('#entry-form');form.elements.namedItem('entry_id').value=item.id;for(const f of s.fields){const node=form.elements.namedItem(f[0]);if(f[2]==='checkbox')node.checked=Boolean(item[f[0]]);else node.value=item[f[0]]??'';}form.querySelector('button[type=submit]').textContent='UPDATE ENTRY ↗';form.scrollIntoView({behavior:'smooth',block:'center'});}));el.querySelectorAll('[data-delete]').forEach(b=>b.addEventListener('click',async()=>{if(!confirm('Delete this entry?'))return;const{error}=await supabase.from(s.table).delete().eq('id',b.dataset.delete);if(error)alert(error.message);else loadTab();}));}
async function refreshSession(){if(!supabase)return;const{data}=await supabase.auth.getSession();const user=data.session?.user;if(!user){login?.classList.remove('hidden');dash?.classList.add('hidden');return;}const isAdmin=user.app_metadata?.role==='admin';if(!isAdmin){await supabase.auth.signOut();loginStatus.textContent='This account does not have administrator access.';return;}login?.classList.add('hidden');dash?.classList.remove('hidden');$('#admin-email').textContent=user.email||'Administrator';loadTab();}
if(!isSupabaseConfigured||!supabase){config.textContent='Supabase is not configured. Add PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY to your GitHub Actions repository secrets, then rebuild.';$('#login-form')?.addEventListener('submit',e=>{e.preventDefault();loginStatus.textContent='Connect Supabase first.';});}else{config.classList.add('hidden');$('#login-form')?.addEventListener('submit',async e=>{e.preventDefault();loginStatus.textContent='Signing in…';const{error}=await supabase.auth.signInWithPassword({email:$('#email').value,password:$('#password').value});if(error)loginStatus.textContent=error.message;else refreshSession();});refreshSession();}
$('#logout')?.addEventListener('click',async()=>{await supabase?.auth.signOut();refreshSession();});document.querySelectorAll('[data-tab]').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('[data-tab]').forEach(x=>x.classList.remove('active'));b.classList.add('active');currentTab=b.dataset.tab;loadTab();}));
</script>
