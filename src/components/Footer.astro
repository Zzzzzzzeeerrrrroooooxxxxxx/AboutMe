---
import {site} from '../data';const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<footer class="site-footer wrap"><div><a class="footer-brand" href={`${base}/`}>LUMINAC<span>21</span></a><p>Independent engineering profile · {site.collective}</p></div><div class="footer-links">{site.links.map(l=><a href={l.href} target="_blank" rel="noopener noreferrer">{l.label} ↗</a>)}<a href={`${base}/admin/`}>ADMIN</a></div><small>© {new Date().getFullYear()} LUMINAC21. BUILT WITH INTENT. NO FABRICATED METRICS.</small></footer>
